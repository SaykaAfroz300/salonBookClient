NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth & MongoDB (Server-side only)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/salonbook?retryWrites=true&w=majority
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Shared JWT Secret (must match salonbook-server JWT_SECRET)
JWT_SECRET=your_shared_jwt_secret_minimum_32_characters

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImgBB Image Hosting API Key (Server-side proxy upload)
IMGBB_API_KEY=your_imgbb_api_key
